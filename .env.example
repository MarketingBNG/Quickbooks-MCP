# Public HTTPS URL where this server is reachable (no trailing slash)
BASE_URL=https://qbo-mcp.example.com
PORT=3000

# From https://developer.intuit.com -> your app -> Keys & credentials
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
# "sandbox" or "production"
INTUIT_ENV=sandbox

# 32-byte hex key used to encrypt stored QuickBooks tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Where the token store lives (use a persistent volume in production)
DATA_FILE=./data/store.json
